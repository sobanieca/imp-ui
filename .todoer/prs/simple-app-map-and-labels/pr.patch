+
+const teamMap = () =>
+  appMap({ orgs: { $orgId: { teams: { $teamId: {} }, settings: {} } }, other: {} })
+
+const routeLabels = { handle: null }
+
+const gates = new Map()
+
+const gateOf = (id) => {
+  if (!gates.has(id)) {
+    let open = null
+    const promise = new Promise((resolve) => {
+      open = resolve
+    })
+    gates.set(id, { promise, open })
+  }
+  return gates.get(id)
+}
+
+const teamScreen = component('r-team-screen', {
+  setup: async (self, { orgId, teamId }) => {
+    routeLabels.handle = useState(self, 'imp.routeLabels')
+    await gateOf(teamId).promise
+    routeLabels.handle.set((all) => ({ ...all, $orgId: `Org ${orgId}`, $teamId: `Team ${teamId}` }))
+    return div(`team ${teamId}`)
+  },
+})
+
+const settingsScreen = component('r-settings-screen', {
+  setup: (self) => {
+    routeLabels.handle = useState(self, 'imp.routeLabels')
+    return div('settings')
+  },
+})
+
+const shownCrumbs = (app) =>
+  mapNav(app)
+    .current.get()
+    .crumbs.map((crumb) => (crumb.loading ? '...' : crumb.label))
+
+const mountTeams = (app, extra = {}) => {
+  gates.clear()
+  mountRouter({
+    map: app,
+    screens: {
+      [app.orgs.$orgId.teams.$teamId]: ({ params }) => teamScreen(params),
+      [app.orgs.$orgId.settings]: () => settingsScreen(),
+    },
+    title: ({ crumbs }) => crumbs.join(' / '),
+    ...extra,
+  })
+}
+
+const leaveTeams = async () => {
+  navigate('/other')
+  await settled()
+  document.body.replaceChildren()
+}
