+  const stop = mapNav(app).current.watch(() => seen.push(shownCrumbs(app)))
+  mountTeams(app)
+  await settled()
+  expect(shownCrumbs(app)).toEqual(['Orgs', '...', 'Teams', '...'])
+  gateOf('t1').open()
+  await settled()
