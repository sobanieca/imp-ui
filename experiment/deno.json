{
  "tasks": {
    "dev": "deno run -A cli/main.js dev",
    "test": "deno test -A tests/",
    "lint": "deno run -A cli/main.js lint imp/ stdlib/ examples/ showcase/",
    "fmt": "deno fmt",
    "showcase": "deno run -A cli/main.js showcase"
  },
  "lint": {
    "plugins": ["./cli/lint_plugin.js"],
    "rules": {
      "exclude": ["no-window", "no-window-prefix", "no-import-prefix"]
    }
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100
  }
}
