{
  "tasks": {
    "imp": "deno run -A src/cli/main.js",
    "vendor": "deno run -A tools/vendor.js",
    "compile": "deno run -A tools/vendor.js && deno compile -A --include src/cli/vendor -o imp src/cli/main.js",
    "test": "deno run -A tools/vendor.js && deno test -A test/",
    "test:update": "deno run -A tools/vendor.js && deno test -A test/ -- --update"
  },
  "imports": {
    "@dprint/formatter": "npm:@dprint/formatter@^0.5",
    "@eslint/js": "npm:@eslint/js@^9",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11",
    "@std/path": "jsr:@std/path@^1",
    "esbuild": "npm:esbuild@^0.24",
    "eslint": "npm:eslint@^9",
    "globals": "npm:globals@^16"
  },
  "lint": {
    "exclude": ["prev/", "test/fixtures/"]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": ["prev/", "test/fixtures/", "test/snapshots/"]
  }
}
