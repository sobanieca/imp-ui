{
  "version": "0.1.0",
  "tasks": {
    "example": "cd examples && deno run -A ../tools/imp.js start --no-reload",
    "preview": "cd lib/src && deno run -A ../../tools/imp.js preview --no-reload",
    "site": "deno run -A tools/build-site.js && cd site/dist && rfm",
    "test": "cd lib/test && deno run -A ../../tools/imp.js test --unit && deno run -A ../../tools/imp.js test --e2e && cd ../.. && deno test -A cli/test/ --",
    "check": "deno lint && deno fmt && cd lib/src && deno run -A ../../tools/imp.js lint"
  },
  "imports": {
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
    "@dprint/formatter": "npm:@dprint/formatter@^0.5.1",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.7",
    "esbuild-wasm/": "npm:/esbuild-wasm@0.28.1/"
  },
  "test": {
    "exclude": ["cli/test/fixtures/"]
  },
  "lint": {
    "exclude": [
      "cli/test/fixtures/",
      "lib/src/icons/lucide-icons.js",
      "lib/src/std/data/map-world-110m.js",
      "lib/src/std/data/map-world-50m.js",
      "lib/src/std/data/map-roads-10m.js",
      "cli/src/vendor/",
      "site/dist/",
      ".claude/worktrees/"
    ]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": [
      "cli/test/fixtures/",
      "cli/test/snapshots/",
      "cli/src/templates/",
      "lib/src/icons/lucide-icons.js",
      "lib/src/std/data/map-world-110m.js",
      "lib/src/std/data/map-world-50m.js",
      "lib/src/std/data/map-roads-10m.js",
      "cli/src/vendor/",
      "site/dist/",
      "examples/",
      ".claude/worktrees/"
    ]
  }
}
