{
  "tasks": {
    "imp": "deno run -A src/cli/main.js",
    "test": "deno test -A test/",
    "test:update": "deno test -A test/ -- --update"
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11",
    "@std/path": "jsr:@std/path@^1",
    "esbuild": "npm:esbuild@^0.24"
  },
  "lint": {
    "exclude": ["prev/", "test/fixtures/"]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": ["prev/", "test/fixtures/", "test/snapshots/"]
  }
}
