{
  "tasks": {
    "imp": "deno run -A src/cli/main.js",
    "update": "deno outdated --update --latest && deno run -A tools/update_dprint.js",
    "compile": "deno run -A tools/download_fmt_plugins.js && deno run -A tools/prebundle_npm_deps.js && deno compile -A --include src -o imp src/cli/main.js",
    "test": "deno task compile && deno test -A test/cli_test.js",
    "test:update": "deno task compile && deno test -A test/cli_test.js -- --update"
  },
  "imports": {
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
    "@dprint/formatter": "npm:@dprint/formatter@^0.5.1",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.7",
    "esbuild-wasm/": "npm:/esbuild-wasm@0.28.1/"
  },
  "lint": {
    "exclude": ["prev/", "test/fixtures/", "src/cli/vendor/"]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": ["prev/", "test/fixtures/", "test/snapshots/", "src/cli/vendor/"]
  }
}
