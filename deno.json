{
  "tasks": {
    "imp": "deno run -A src/cli/main.js",
    "update": "deno outdated --update --latest && deno run -A tools/update_dprint.js",
    "compile": "deno run -A tools/download_fmt_plugins.js && deno compile -A --include src -o imp src/cli/main.js",
    "test": "deno task compile && deno test -A test/",
    "test:update": "deno task compile && deno test -A test/ -- --update"
  },
  "imports": {
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
    "@dprint/formatter": "npm:@dprint/formatter@^0.5.1",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@std/path": "jsr:@std/path@^1.1.6",
    "esbuild-wasm/": "npm:/esbuild-wasm@0.28.1/",
    "eslint": "npm:eslint@^10.6.0",
    "globals": "npm:globals@^17.7.0"
  },
  "lint": {
    "exclude": ["prev/", "test/fixtures/"]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": ["prev/", "test/fixtures/", "test/snapshots/"]
  }
}
